Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(app|config|database|resources|storage|tests)(/|$) - [F,L,NC]
RewriteRule ^(\.git|\.github)(/|$) - [F,L,NC]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]
</IfModule>
<FilesMatch "^(\.env|database\.local\.php|.*\.log|.*\.sql|.*\.local\.php)$">
Require all denied
</FilesMatch>